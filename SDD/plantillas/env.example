# =====================================================================
# Seguros Castaño - desarrollo local
# Copiar este archivo a `.env`. NUNCA commitear `.env`.
# Reemplazá los valores de ejemplo localmente; esta plantilla no contiene secretos.
# =====================================================================

# --- Django ----------------------------------------------------------
# Generar uno propio: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame-generando-una-clave-propia
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL local (sin TLS) --------------------------------------
# Para producción configurá DB_SSLMODE=require y usá un servidor con TLS.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyecto
DB_USER=postgres
DB_PASSWORD=cambiame-por-la-clave-de-tu-base
DB_SSLMODE=disable

# --- WhatsApp --------------------------------------------------------
# simulado = no llama a Meta, los envíos se registran en el log (para desarrollar)
# real     = usa la API de WhatsApp Cloud (requiere los 5 valores de abajo)
WHATSAPP_MODO=simulado
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# --- LLM (modelo gratuito vía API compatible con OpenAI) --------------
# none = el bot usa solo el clasificador por reglas (no necesita clave)
# openai_compat = completar LLM_BASE_URL, LLM_API_KEY y LLM_MODEL
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Segundos que el bot espera por si el cliente sigue escribiendo, antes de
# contestar. Junta los mensajes partidos en una sola respuesta y un solo caso.
# 0 = contesta cada mensaje por separado (el comportamiento viejo).
BOT_VENTANA_AGRUPACION_SEGUNDOS=5

# --- Bot -------------------------------------------------------------
# Dominios que el bot puede mencionar, separados por coma. Vacío = ninguno.
BOT_URLS_PERMITIDAS=

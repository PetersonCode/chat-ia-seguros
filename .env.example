# =====================================================================
# Seguros Castaño - variables de entorno
# Copiar este archivo a `.env`. NUNCA commitear `.env`.
# Los datos de la base son los reales de este equipo: la base está abierta a
# propósito, es local, tiene solo datos ficticios y se borra en un mes.
# Los tokens de WhatsApp y de LLM sí son secretos: van solo en tu `.env`.
# =====================================================================

# --- Django ----------------------------------------------------------
# Generar uno propio: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame-generando-una-clave-propia
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos compartida (PostgreSQL 17, SSL obligatorio) --------
# SSL no es opcional: el servidor rechaza las conexiones sin SSL.
DB_HOST=localhost
DB_PORT=25432
DB_NAME=proyecto
DB_USER=irusu
DB_PASSWORD=cambiame-por-la-clave-de-tu-base

# --- WhatsApp --------------------------------------------------------
# simulado = no llama a Meta, los envíos se registran en el log (para desarrollar)
# real     = usa la API de WhatsApp Cloud (requiere los 5 valores de abajo)
WHATSAPP_MODO=simulado
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# --- LLM (modelo gratuito vía API compatible con OpenAI) --------------
# none = el bot usa solo el clasificador por reglas (no necesita clave)
# openai_compat = completar LLM_BASE_URL, LLM_API_KEY y LLM_MODEL
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Bot -------------------------------------------------------------
# Dominios que el bot puede mencionar, separados por coma. Vacío = ninguno.
BOT_URLS_PERMITIDAS=

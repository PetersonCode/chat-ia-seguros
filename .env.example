# =====================================================================
# Seguros Castaño - variables de entorno
# Copiar este archivo a `.env`. NUNCA commitear `.env`.
# Esta plantilla se versiona y no lleva secretos. Usar una base de prueba
# con información ficticia para la exposición. No borra datos al arrancar.
# La clave de la base y los tokens de WhatsApp y de LLM van solo en tu `.env`.
# =====================================================================

# --- Django ----------------------------------------------------------
# Generar uno propio: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame-generando-una-clave-propia
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos PostgreSQL 17 (TLS obligatorio en producción) --------
# En producción usar DB_SSLMODE=require o verify-full con certificado CA.
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_NAME=proyecto
DB_USER=seguros_dev
DB_PASSWORD=cambiame-por-la-clave-de-tu-base

# --- WhatsApp --------------------------------------------------------
# simulado = no llama a Meta, registra solo ID/estado de envíos (para desarrollar)
# real     = usa la API de WhatsApp Cloud (requiere los 5 valores de abajo)
WHATSAPP_MODO=simulado
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# --- LLM opcional (local o API compatible; revisar costos del proveedor) --------------
# none = el bot usa solo el clasificador por reglas (no necesita clave)
# openai_compat = completar LLM_BASE_URL, LLM_API_KEY y LLM_MODEL
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Segundos que el bot espera por si el cliente sigue escribiendo, antes de
# contestar. Junta los mensajes partidos en una sola respuesta y un solo caso.
# 0 = contesta cada mensaje por separado (el comportamiento viejo).
BOT_VENTANA_AGRUPACION_SEGUNDOS=3

# --- Bot -------------------------------------------------------------
# Dominios que el bot puede mencionar, separados por coma. Vacío = ninguno.
BOT_URLS_PERMITIDAS=

# Búsqueda gratuita local: primero python manage.py preparar_busqueda
BUSQUEDA_SEMANTICA=true
# MODELO_BUSQUEDA_DIR=/ruta/privada/modelos
# HTTP para Ollama solo en red privada; HTTPS para proveedores remotos.
LLM_HTTP_HOSTS=localhost,127.0.0.1,ollama

MODO_DEMOSTRACION=false
